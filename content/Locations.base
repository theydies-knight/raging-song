filters:
  and:
    - file.folder == "Locations"
    - '!file.name.contains("index")'
views:
  - type: table
    name: View
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 220
