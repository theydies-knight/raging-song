filters:
  and:
    - file.folder == "adventure-log"
    - file.name != "index"
properties:
  file.name:
    displayName: Session
views:
  - type: table
    name: View
    order:
      - date
      - file.name
    sort:
      - property: date
        direction: DESC
      - property: file.name
        direction: ASC
